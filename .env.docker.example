# ==============================================================================
#Docker Environment Configuration
# Copy this file to .env before running: docker compose up -d --build
# ==============================================================================

# Database Configuration (matches docker-compose.yml 'db' service)
POSTGRES_DB=cosmos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=astrorag_secure_password
POSTGRES_PORT=5434

# Application Port on Host
APP_PORT=3000

# Session Secret (must be at least 32 characters)
SESSION_SECRET=change-this-to-a-secure-random-string-with-at-least-32-chars

# Gemini API Configuration (server-side only, for grounded RAG answers)
GEMINI_API_KEY=replace-with-your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# System Account Passwords
# These passwords are read from the environment and hashed dynamically via scrypt with random salt.
# Neither password is hard-coded anywhere in code or database dumps.
ADMIN_PASSWORD=change-to-your-strong-admin-password
USER_PASSWORD=change-to-your-strong-user-password

# Automatic database migrations and seed on container startup (true/false)
AUTO_SEED=true
