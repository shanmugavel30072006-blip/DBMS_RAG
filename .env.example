# Copy to .env.local. Never commit the filled-in file.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5434/astrorag
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
# Server-side only. Never use NEXT_PUBLIC_ for this value.
GEMINI_API_KEY=replace-with-your-new-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# System Account Passwords (hashed via scrypt on first bootstrap)
ADMIN_PASSWORD=replace-with-strong-admin-password
USER_PASSWORD=replace-with-strong-user-password
